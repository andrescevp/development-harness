{
  "name": "dev-harness-skills",
  "version": "0.4.0",
  "type": "module",
  "description": "OpenCode V2 plugin with an opinionated development harness based in plan execution loop architecture",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "bin": {
    "dev-harness-mcp": "./dist/mcp/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && npm run copy-assets",
    "build:runtime": "tsup && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepare": "node scripts/prepare.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke-load": "node scripts/smoke-load.mjs",
    "smoke-mcp": "node scripts/smoke-mcp.mjs",
    "lint:biome": "biome check src/ scripts/",
    "format:biome": "biome check --write src/ scripts/",
    "format:biome:check": "biome check src/ scripts/",
    "lint:knip": "knip",
    "lint:dup": "jscpd",
    "lint:depcruise": "depcruise src --config .dependency-cruiser.json",
    "scan:deps": "docker run --rm -v \"${PWD}:/src\" ghcr.io/google/osv-scanner --config=/src/.osv-scanner.toml --lockfile /src/pnpm-lock.yaml",
    "scan:code": "docker run --rm -v \"${PWD}:/src\" semgrep/semgrep semgrep --config=p/typescript --config=p/security-audit --metrics=off /src/src",
    "qa:fix": "pnpm format:biome",
    "qa:check": "pnpm lint:biome && pnpm format:biome:check && pnpm lint:knip && pnpm lint:dup && pnpm lint:depcruise && pnpm lint:links && pnpm scan:deps && pnpm scan:code",
    "qa:check:full": "pnpm qa:check && pnpm build && pnpm test && pnpm typecheck && pnpm run audit && node scripts/smoke-load.mjs && node scripts/smoke-mcp.mjs",
    "lint:links": "node scripts/check-links.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@opencode/plugin": "^2.0.20",
    "duckdb": "^1.4.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.3",
    "dependency-cruiser": "^18.4.0",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "project": [
      "src/**/*.ts"
    ],
    "ignoreDependencies": [],
    "ignore": []
  }
}
