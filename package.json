{
  "name": "dev-harness-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode V2 plugin bundling the scoped dev harness manifest (6 agents, 12 skills) from the personal harness at ~/.agents",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke-load": "node scripts/smoke-load.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.18",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}