{
  // Example opencode.jsonc — enable the dev-harness-skills V2 plugin.
  // NOTE (verified against opencode v2.0.18): `plugins` entries that are
  // `file://` URLs must point to a DIRECTORY, not a plugin.js file — the
  // file form is rejected with "configured plugin path must be a directory".
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // Local package directory form (works after `pnpm build` in the repo):
    "file:///home/andres/workspace/dev-harness-skills"

    // Alternatives (pick ONE at a time):
    // - Installed package form (after `pnpm pack` / install):
    //   "dev-harness-skills"
    // - Relative directory form from your project root:
    //   "../shared/dev-harness-skills"
  ],
  // Project-scope MCP server serving the 7 harness tools (plan lifecycle,
  // sheets, logged commands). The plugin itself registers agents + skills
  // only — add this block to the PROJECT's opencode.jsonc. The server starts
  // per project via npx from the git repository; `protocol` pins the native
  // MCP revision (legacy initialize clients are still served).
  "mcp": {
    "servers": {
      "dh": {
        "type": "local",
        "command": ["npx", "-y", "--package=github:andrescevp/development-harness", "dev-harness-mcp"],
        "protocol": "2026-07-28",
        // Cold first npx install can take ~20–25 s; prewarm makes later starts fast.
        "timeout": { "startup": 300000 }
        // Optional workspace override (defaults to the project cwd):
        // ,"environment": { "DH_WORKSPACE_ROOT": "/absolute/workspace" }
      }
    }
  },
  // Verification checklist after loading (opencode v2.0.18):
  //   opencode debug agents → the 7 dh-* agents: dh-software-architect,
  //                           dh-software-engineer, dh-reviewer,
  //                           dh-final-reviewer, dh-executor, dh-explorer,
  //                           dh-documentor
  //   (17 skills: no debug subcommand on v2.0.18 — see skills/index.md)
  //   opencode debug config → the plugin entry + mcp.servers.dh
  //   opencode mcp list     → `dh` connected (server/status only)
  //   expected tools        → dh_plan_read, dh_plan_update_status,
  //                           dh_plan_create, dh_read_sheet,
  //                           dh_update_sheet, dh_sheet_schema,
  //                           dh_logged_command
  //
  // Troubleshooting: see docs/LOADING.md.
}